# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB default or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/hacxlerate

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_characters_placeholder
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_placeholder

# Client URL (for CORS and redirects)
CLIENT_URL=http://localhost:5173

# Pluggable AI Adapter Configuration
# Leave blank to automatically use the zero-mock local deterministic heuristic engine
GEMINI_API_KEY=your_gemini_api_key_placeholder
AI_PROVIDER=auto

# Local Upload Directory
UPLOAD_DIR=uploads
